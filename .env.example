# Primera ejecución sin alertas. El programa usa true si ENABLE_ALERTS está ausente.
ENABLE_ALERTS=false
WEBHOOK_URL=

# Para Discord: cambiar a true y guardar el webhook real SOLO en .env local.
# Con alertas habilitadas, un webhook válido es obligatorio antes de comprobar.
# Las variables del proceso tienen prioridad sobre .env.
# El umbral de latencia se configura en config/targets.json.
